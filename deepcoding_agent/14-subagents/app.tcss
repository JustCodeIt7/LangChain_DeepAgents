/* DeepCoder styling. Textual CSS: selectors, then properties. */

#chat {
    height: 1fr;          /* take all the space the other widgets do not */
    padding: 1 2;
    background: $surface;
}

#chat Markdown {
    margin: 0 0 1 0;
}

.user {
    color: $success;
}

.assistant {
    color: $text;
}

/* Docked widgets stack in the order they are docked, so the status line is
   declared after the input in compose() and ends up just above the footer. */
#prompt {
    height: 3;
    margin: 0 1;
}

#status {
    height: 1;
    padding: 0 2;
    color: $text-muted;
    background: $panel;
}

.tool {
    color: $text-accent;
    margin: 0 0 1 2;
}

/* The approval dialog floats over the chat. */
ApprovalScreen {
    align: center middle;
    background: $background 60%;
}

#approval {
    width: 70;
    max-height: 20;
    padding: 1 2;
    border: thick $warning;
    background: $surface;
}

#approval-title {
    text-style: bold;
    margin: 0 0 1 0;
}

.action {
    color: $text-accent;
    margin: 0 0 1 1;
}

#approval-buttons {
    height: auto;
    align: center middle;
}

#approval-buttons Button {
    margin: 0 1;
}

/* Chat and plan sit side by side inside #body. */
#body {
    height: 1fr;
}

#plan {
    width: 34;
    padding: 1 2;
    border-left: solid $primary;
    background: $panel;
    color: $text;
}

.nested {
    color: $text-muted;
}
